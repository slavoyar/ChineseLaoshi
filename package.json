{
  "name": "chinese-laoshi",
  "private": true,
  "type": "module",
  "workspaces": [
    "web"
  ],
  "author": "Yaroslav Zaprudskii",
  "license": "ISC",
  "scripts": {
    "lint": "npm run lint:frontend",
    "lint:frontend": "eslint \"web/src/study/**/*.{ts,tsx}\" \"web/app/app/**/*.{ts,tsx}\" -c ./web/eslint.config.js --report-unused-disable-directives --max-warnings 0 --fix",
    "dev:web": "npm run dev --workspace=@chinese-laoshi/web",
    "dev:backend": "cd backend && go run ./cmd/server",
    "generate:types": "tygo generate",
    "test:e2e": "npm run test:e2e --workspace=@chinese-laoshi/web"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@typescript-eslint/eslint-plugin": "^8.63.0",
    "@typescript-eslint/parser": "^8.63.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-simple-import-sort": "^13.0.0",
    "prettier": "^3.9.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.63.0"
  }
}
