{
  "name": "@chinese-laoshi/backend",
  "version": "1.0.0",
  "description": "Backend for Chinese Laoshi",
  "main": "./src/index.ts",
  "scripts": {
    "lint": "eslint src/**/*.ts --fix",
    "dev": "webpack --config webpack.dev.js & nodemon dist/index.js",
    "build": "npm run generate && webpack --config webpack.prod.js",
    "start": "node dist/index.js",
    "migrate:dev": "prisma migrate dev --schema src/configs/prisma/schema.prisma",
    "migrate:prod": "prisma migrate deploy --schema src/configs/prisma/schema.prisma",
    "generate": "prisma generate --schema src/configs/prisma/schema.prisma",
    "seed": "node src/configs/prisma/seed.ts",
    "test": "jest",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "@chinese-laoshi/shared": "*",
    "@prisma/client": "^5.15.0",
    "ajv-formats": "^3.0.1",
    "bcryptjs": "^3.0.2",
    "chalk": "^5.4.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-async-errors": "^3.1.1",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^6.9.14"
  },
  "devDependencies": {
    "@babel/plugin-transform-modules-commonjs": "^7.26.3",
    "@babel/preset-env": "^7.26.9",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/nodemailer": "^6.4.15",
    "@types/supertest": "^6.0.3",
    "babel-jest": "^29.7.0",
    "ignore-loader": "^0.1.2",
    "jest": "^29.7.0",
    "nodemon": "^3.1.9",
    "prisma": "^5.15.0",
    "prisma-import": "^1.0.5",
    "supertest": "^7.1.0",
    "ts-jest": "^29.3.1",
    "ts-loader": "^9.5.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.8.3",
    "webpack": "^5.94.0",
    "webpack-cli": "^5.1.4",
    "webpack-merge": "^6.0.1",
    "webpack-node-externals": "^3.0.0"
  }
}
