{
  "name": "@chinese-laoshi/backend",
  "version": "1.0.0",
  "description": "Backend for Chinese Laoshi",
  "main": "./src/index.ts",
  "scripts": {
    "lint": "eslint src/**/*.ts --fix",
    "dev": "webpack --config webpack.dev.js & nodemon dist/index.js",
    "build": "npm run generate && webpack --config webpack.prod.js",
    "start": "node dist/index.js",
    "migrate:dev": "prisma migrate dev --schema src/configs/prisma/schema.prisma",
    "migrate:prod": "prisma migrate deploy --schema src/configs/prisma/schema.prisma",
    "generate": "prisma generate --schema src/configs/prisma/schema.prisma",
    "seed": "node src/configs/prisma/seed.ts",
    "test": "jest",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "@chinese-laoshi/shared": "*",
    "@prisma/client": "^5.22.0",
    "ajv-formats": "^3.0.1",
    "chalk": "^5.6.2",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^4.22.2",
    "express-async-errors": "^3.1.1"
  },
  "devDependencies": {
    "@babel/plugin-transform-modules-commonjs": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/jest": "^29.5.14",
    "@types/supertest": "^6.0.3",
    "babel-jest": "^29.7.0",
    "ignore-loader": "^0.1.2",
    "jest": "^29.7.0",
    "nodemon": "^3.1.14",
    "prisma": "^5.22.0",
    "prisma-import": "^1.0.5",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.11",
    "ts-node": "^10.9.2",
    "ts-loader": "^9.6.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3",
    "webpack": "^5.108.4",
    "webpack-cli": "^5.1.4",
    "webpack-merge": "^6.0.1",
    "webpack-node-externals": "^3.0.0"
  }
}
