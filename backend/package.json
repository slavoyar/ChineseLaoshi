{
  "name": "@chinese-laoshi/backend",
  "version": "1.0.0",
  "description": "Backend for Chinese Laoshi",
  "main": "./src/index.ts",
  "scripts": {
    "lint": "eslint src/**/*.ts --fix",
    "dev": "webpack --config webpack.dev.js & nodemon dist/index.js",
    "build": "npm run generate && webpack --config webpack.prod.js",
    "start": "node dist/index.js",
    "migrate:dev": "prisma migrate dev --schema src/configs/prisma/schema.prisma",
    "migrate:prod": "prisma migrate deploy --schema src/configs/prisma/schema.prisma",
    "generate": "prisma generate --schema src/configs/prisma/schema.prisma"
  },
  "prisma": {
    "seed": "node src/configs/prisma/seed.ts"
  },
  "dependencies": {
    "@chinese-laoshi/shared": "*",
    "@prisma/client": "^5.15.0",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/nodemailer": "^6.4.15",
    "@types/passport": "^1.0.16",
    "@types/passport-local": "^1.0.38",
    "ajv-formats": "^3.0.1",
    "bcryptjs": "^3.0.2",
    "chalk": "^5.4.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-async-errors": "^3.1.1",
    "express-session": "^1.18.0",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^6.9.14",
    "passport": "^0.7.0",
    "passport-local": "^1.0.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/express-session": "^1.18.0",
    "nodemon": "^3.1.9",
    "prisma": "^5.15.0",
    "prisma-import": "^1.0.5",
    "ts-loader": "^9.5.2",
    "tsconfig-paths": "^4.2.0",
    "webpack": "^5.94.0",
    "webpack-cli": "^5.1.4",
    "webpack-merge": "^6.0.1",
    "webpack-node-externals": "^3.0.0"
  }
}
