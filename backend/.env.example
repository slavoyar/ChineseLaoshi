PORT=3000
DB_URL=
DATA_DIR=./data/pg

# Demo template user (anonymous reads + clone source for new SSO users)
TEMPLATE_USER_EMAIL=demo-template@chineselaoshi.local

# Required for Google SSO
GOOGLE_CLIENT_ID=
JWT_SECRET=

# Optional
# COOKIE_SECURE=false
# SESSION_TTL_HOURS=168
# NODE_ENV=development
# Comma-separated browser origins allowed for Google login (CSRF mitigation)
# ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
