PORT=3000
DB_URL=
DATA_DIR=./data/pg

# Demo template user (anonymous reads + clone source for new SSO users)
TEMPLATE_USER_EMAIL=demo-template@chineselaoshi.local

# Required for Google SSO
GOOGLE_CLIENT_ID=
JWT_SECRET=

# Comma-separated browser origins allowed for all /api requests (Origin/Referer).
# Non-production defaults to http://localhost:5173 and http://127.0.0.1:5173.
# Production: set explicitly (empty allowlist rejects every request).
# ALLOWED_ORIGINS=https://chineselaoshi.slavoyar.tech
# NODE_ENV=development
# COOKIE_SECURE=false
# SESSION_TTL_HOURS=168

# Optional: ERROR logs POSTed to Telegram via a Caddy relay.
# All three required (relay base must be https); leave empty locally — no outbound calls.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# TELEGRAM_RELAY_BASE=